<Project Sdk="Microsoft.NET.Sdk">
  <!-- The engine core and the game simulation. No platform code: runs anywhere .NET 8 runs,
       so the headless tests in ../Test can drive it on any OS. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>GermBall.Proto</RootNamespace>
    <AssemblyName>GermBall.Proto.Core</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
