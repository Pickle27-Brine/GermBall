<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless smoke test: builds every map and runs the simulation without a window, GPU or audio device.
       Runs anywhere .NET 8 runs (used to check the port on a machine without Windows). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\GermBall\GermBall.csproj" />
  </ItemGroup>
</Project>
